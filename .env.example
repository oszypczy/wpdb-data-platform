# Copy to .env (make up does it when .env is missing). .env is gitignored.
# Secrets only live here and in the environment, never in compose or Dockerfiles.
# Versions are NOT configured here: they are pinned in docker-compose.yml and the
# Dockerfiles (the version matrix in docs/design/08-operations.md).

# --- PostgreSQL (database shop, schemas shop + sim) -------------------------
POSTGRES_PASSWORD=postgres-dev            # superuser `postgres`: only the initdb scripts
SHOP_APP_PASSWORD=shop_app-dev            # role shop_app: the simulator (DDL+DML in shop, writes sim)
DEBEZIUM_DB_PASSWORD=debezium-dev         # role debezium: REPLICATION + SELECT on shop
READER_PASSWORD=reader                    # role reader: SELECT on shop and sim (tests, MCP postgres)

# --- MinIO ------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin                # root: only minio-init
MINIO_ROOT_PASSWORD=minioadmin-dev        # >= 8 characters
MINIO_SPARK_ACCESS_KEY=spark              # account spark: read/write on all buckets
MINIO_SPARK_SECRET_KEY=spark-secret-dev   # >= 8 characters
MINIO_DASHBOARD_ACCESS_KEY=dashboard      # account dashboard: read-only on gold and ops
MINIO_DASHBOARD_SECRET_KEY=dashboard-secret-dev
MINIO_AGENT_ACCESS_KEY=agent              # account agent: read-only on all buckets (MCP duckdb, tests)
MINIO_AGENT_SECRET_KEY=agent-secret-dev

# --- Kafka (KRaft) ----------------------------------------------------------
# Fixed cluster id (base64 UUID, 22 chars): the data volume is formatted with it,
# so the broker always starts on its existing log after a restart.
KAFKA_CLUSTER_ID=oprjffzpQ8K-n4wKNzsdiQ

# --- Business simulator (stage 1; see docs/design/01-business-system.md §4) ---
# Defaults are deliberately small: 3 months of history in ~90 minutes at a few row
# changes per second, so `make up` never overloads the stack. History before
# SIM_START is bulk-loaded first (Debezium sees it as a snapshot), [SIM_START, SIM_END]
# is replayed live, then the simulator idles (phase `done`; `make reset` to start over).
# Presentation (Black Friday 2017-11-24 hits the limiter): SIM_SPEED=1440
# MAX_EVENTS_PER_SEC=50 SIM_START=2017-11-20 SIM_END=2017-12-10 (preload ≈ 283k rows).
SIM_SPEED=1440                            # time multiplier: 1440 = one day of history per minute
MAX_EVENTS_PER_SEC=20                     # hard cap on row changes per second; the simulated clock slows down above it
SIM_START=2017-01-05                      # replay window start (first purchases of 2017) (date or "YYYY-MM-DD HH:MM:SS")
SIM_END=2017-03-31                        # replay window end, inclusive (a date means its last second)
# Synthetic schema evolution (01 §7): at this simulated moment the simulator runs once
# ALTER TABLE shop.orders ADD COLUMN delivery_channel TEXT NULL and fills it for later
# purchases. Empty = off (default). Keep it off while tests/integration/test_debezium.py
# runs: that test adds and drops the same column itself. Example: 2017-02-01
SIM_SCHEMA_EVOLUTION_AT=
