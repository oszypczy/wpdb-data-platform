{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:*"],
      "Resource": [
        "arn:aws:s3:::bronze", "arn:aws:s3:::bronze/*",
        "arn:aws:s3:::silver", "arn:aws:s3:::silver/*",
        "arn:aws:s3:::gold", "arn:aws:s3:::gold/*",
        "arn:aws:s3:::ops", "arn:aws:s3:::ops/*",
        "arn:aws:s3:::checkpoints", "arn:aws:s3:::checkpoints/*"
      ]
    }
  ]
}
