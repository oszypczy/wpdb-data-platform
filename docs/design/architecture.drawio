  <diagram id="c4-container" name="C4 – kontenery">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="bnd" value="Mini Data Platform — Docker Compose „wpdb” (jedna sieć, każdy komponent w osobnym kontenerze)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#444444;align=left;verticalAlign=top;fontStyle=1;fontSize=13;spacingLeft=10;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="240" y="40" width="1620" height="790" as="geometry"/></mxCell>
        <mxCell id="csv" value="&lt;b&gt;Olist Brazilian E-Commerce&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Pliki CSV, data/olist/]&lt;/i&gt;&lt;br&gt;&lt;br&gt;9 plików, ~100 tys. zamówień; poza repozytorium (make data)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#6B6B6B;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="320" width="170" height="120" as="geometry"/></mxCell>
        <mxCell id="user" value="&lt;b&gt;Użytkownik&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Osoba]&lt;/i&gt;&lt;br&gt;&lt;br&gt;analityk / prowadzący, przeglądarka" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#073B6F;fontColor=#FFFFFF;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="30" y="560" width="170" height="120" as="geometry"/></mxCell>
        <mxCell id="sim" value="&lt;b&gt;Business Simulator&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Kontener: Python 3.12, psycopg]&lt;/i&gt;&lt;br&gt;&lt;br&gt;odtwarza cykl życia zamówień w przyspieszonym czasie: INSERT → UPDATE → DELETE; limit tempa, wznawianie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="280" y="320" width="200" height="120" as="geometry"/></mxCell>
        <mxCell id="pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Kontener: PostgreSQL 16, wal_level=logical]&lt;/i&gt;&lt;br&gt;&lt;br&gt;schematy shop (CDC) i sim (stan, widoki prawdy); publikacja dbz_publication; role per usługa" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="610" y="310" width="200" height="140" as="geometry"/></mxCell>
        <mxCell id="cn" value="&lt;b&gt;Kafka Connect + Debezium&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Kontener: Debezium 3.6, konwerter AVRO]&lt;/i&gt;&lt;br&gt;&lt;br&gt;konektor olist-postgres: snapshot + strumień, pełna koperta before/after, klucz = PK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="940" y="320" width="200" height="120" as="geometry"/></mxCell>
        <mxCell id="kf" value="&lt;b&gt;Kafka&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Kontener: Kafka 4.3, KRaft single node]&lt;/i&gt;&lt;br&gt;&lt;br&gt;1 temat na tabelę (olist.shop.*), kompaktowane lustra, kolejność per wiersz" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1270" y="310" width="200" height="140" as="geometry"/></mxCell>
        <mxCell id="sr" value="&lt;b&gt;Schema Registry&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Kontener: Confluent SR 8.3]&lt;/i&gt;&lt;br&gt;&lt;br&gt;schematy AVRO klucza i wartości, zgodność BACKWARD" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1105" y="90" width="200" height="100" as="geometry"/></mxCell>
        <mxCell id="sp" value="&lt;b&gt;Spark&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Kontener: Spark 3.5 local[*], Structured Streaming]&lt;/i&gt;&lt;br&gt;&lt;br&gt;dekodowanie AVRO → bronze (append) → silver (MERGE) → gold (gwiazda, okna); kwarantanna" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1600" y="320" width="200" height="120" as="geometry"/></mxCell>
        <mxCell id="mn" value="&lt;b&gt;MinIO + Delta Lake&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Kontener: MinIO (S3), Delta]&lt;/i&gt;&lt;br&gt;&lt;br&gt;kubełki bronze / silver / gold / ops / checkpoints; konta per usługa" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;align=center;spacing=6;" vertex="1" parent="1"><mxGeometry x="1600" y="550" width="200" height="140" as="geometry"/></mxCell>
        <mxCell id="ds" value="&lt;b&gt;Dashboard&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Kontener: Streamlit, delta-rs / DuckDB]&lt;/i&gt;&lt;br&gt;&lt;br&gt;KPI, lejek, logistyka, mapa, zdrowie potoku, podróż w czasie" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="610" y="560" width="200" height="120" as="geometry"/></mxCell>
        <mxCell id="cs" value="&lt;b&gt;Consumer (narzędzie)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Kontener: Python, confluent-kafka]&lt;/i&gt;&lt;br&gt;&lt;br&gt;dekoduje zdarzenia CDC z rejestru, reguły walidacji, śledzenie zamówienia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1270" y="560" width="200" height="120" as="geometry"/></mxCell>
        <mxCell id="note" value="Kontenery startowe (jednorazowe, idempotentne): kafka-init → tematy wewnętrzne; connect-init → rejestracja konektora (PUT); minio-init → kubełki, polityki, konta. Start sterowany healthcheckami (depends_on: service_healthy). Testy: pytest (jednostkowe / integracyjne / e2e z awariami), uzgadnianie Postgres ↔ Delta." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="280" y="710" width="520" height="100" as="geometry"/></mxCell>
